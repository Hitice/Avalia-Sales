# Copie para .env e preencha. O .env não vai para o Git.
PG_SENHA_DONO=
PG_SENHA_APLICACAO=
# 32 caracteres ou mais. Gere com: openssl rand -base64 48
JWT_CHAVE=
# Cifra os e-mails com link de senha ou código na fila (AES-GCM). Obrigatória, igual na API e no Worker.
# Gere com: openssl rand -base64 32. Rotação em docs/OPERACAO.md ("Segredos").
CHAVE_DOS_EMAILS=
# Só durante a rotação: a chave antiga, para abrir o que ela cifrou. Vazia no dia a dia.
CHAVE_ANTERIOR_DOS_EMAILS=

# Pagar.me: chave de teste (sk_test_) no desenvolvimento; recebedor rp_ da Avalia.
# A pública (pk_) liga a venda no cartão; sem ela, a venda é só Pix.
PAGARME_CHAVE_SECRETA=
PAGARME_RECEBEDOR_AVALIA=
PAGARME_CHAVE_PUBLICA=
# Vai na URL do webhook: /webhooks/pagarme/<segredo>. Gere com: openssl rand -hex 32
PAGARME_SEGREDO_DO_WEBHOOK=

# D4Sign sandbox: token da área Dev API, secret key MAC, UUID do cofre e a URL pública do webhook.
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SEGREDO_HMAC=
D4SIGN_COFRE=
D4SIGN_URL_DO_WEBHOOK=

# Plataforma: endereço gravado no QR (mudar depois quebra as placas impressas), o do front e quem recebe os pedidos.
PLATAFORMA_URL_PUBLICA=
PLATAFORMA_URL_DO_PAINEL=
PLATAFORMA_EMAIL_DA_OPERADORA=
# Quem assina pela Avalia: sai impresso no contrato e no distrato, já aceitos na emissão. Opcional.
# Em produção vem das variáveis do ambiente producao no GitHub, que valem mais que este arquivo.
AVALIA_REPRESENTANTE=
AVALIA_CARGO_DO_REPRESENTANTE=

# Opcionais. Sem Resend o e-mail espera na fila; sem Google a busca de lugar pede o link colado.
RESEND_CHAVE_API=
# Entre aspas, por causa do espaço e do <>: "Avalia Sales <nao-responda@sales.avaliaone.com.br>".
RESEND_REMETENTE=
RESEND_RESPONDER_PARA=
GOOGLE_CHAVE_DO_SERVIDOR=

# Captcha do cadastro público (Cloudflare Turnstile). Opcional: vazio, o cadastro roda sem captcha.
# Ligue as duas juntas (docs/OPERACAO.md, "Captcha do cadastro"): a secreta fica só no servidor,
# a do site é pública e entra no build do front. Teste: 1x00000000000000000000AA e 1x0000000000000000000000000000000AA.
TURNSTILE_CHAVE_SITE=
TURNSTILE_CHAVE_SECRETA=
# Teto de e-mails do cadastro público por 24 horas (confirmações e avisos). Padrão 300.
CADASTRO_EMAILS_POR_DIA=300

# Opcional. Sem endereço, a integração com o ERP fica desligada e o pedido pago não entra na fila.
PROTHEUS_URL_BASE=
PROTHEUS_USUARIO=
PROTHEUS_SENHA=

# Produção (docker-compose.producao.yml)
DOMINIO=
EMAIL_DO_CERTIFICADO=
D4SIGN_URL_BASE=https://secure.d4sign.com.br/api/v1/
# Só com a URL do sandbox em produção, de propósito (contrato sem validade jurídica): true.
D4SIGN_SANDBOX_EM_PRODUCAO=
GOOGLE_CHAVE_DO_MAPA=
GOOGLE_ID_DO_MAPA=
SENTRY_DSN=
SENTRY_DSN_DO_FRONT=
PASTA_DE_BACKUP=/srv/avalia-sales/backups
BACKUP_DIAS=14
# Caixa que recebe a cópia diária do banco por e-mail (precisa do Resend). Vazio, só disco.
BACKUP_PARA=
# Senha que criptografa o anexo (openssl, AES-256-CBC). Obrigatória com BACKUP_PARA; guarde fora do VPS, sem ela a cópia por e-mail não abre.
BACKUP_SENHA=
# Cópia fora do VPS, num bucket compatível com S3 (Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com).
# Todas as quatro, mais BACKUP_SENHA: a cópia sempre vai criptografada. Teste com
# docker compose ... exec backup sh /backup.sh testar-bucket
S3_ENDPOINT=
S3_BUCKET=
S3_KEY_ID=
S3_APP_KEY=
BACKUP_DIAS_NO_BUCKET=30
