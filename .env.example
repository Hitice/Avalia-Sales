# Copie para .env e preencha. O .env não vai para o Git.
PG_SENHA_DONO=
PG_SENHA_APLICACAO=
# 32 caracteres ou mais. Gere com: openssl rand -base64 48
JWT_CHAVE=

# Pagar.me: chave de teste (sk_test_) no desenvolvimento; recebedor rp_ da Avalia.
# A pública (pk_) liga a venda no cartão; sem ela, a venda é só Pix.
PAGARME_CHAVE_SECRETA=
PAGARME_RECEBEDOR_AVALIA=
PAGARME_CHAVE_PUBLICA=
# Vai na URL do webhook: /webhooks/pagarme/<segredo>. Gere com: openssl rand -hex 32
PAGARME_SEGREDO_DO_WEBHOOK=

# D4Sign sandbox: token da área Dev API, secret key MAC, UUID do cofre e a URL pública do webhook.
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SEGREDO_HMAC=
D4SIGN_COFRE=
D4SIGN_URL_DO_WEBHOOK=

# Plataforma: endereço gravado no QR (mudar depois quebra as placas impressas), o do front e quem recebe os pedidos.
PLATAFORMA_URL_PUBLICA=
PLATAFORMA_URL_DO_PAINEL=
PLATAFORMA_EMAIL_DA_OPERADORA=
# Quem assina pela Avalia: sai impresso no contrato e no distrato, já aceitos na emissão. Opcional.
# Em produção vem das variáveis do ambiente producao no GitHub, que valem mais que este arquivo.
AVALIA_REPRESENTANTE=
AVALIA_CARGO_DO_REPRESENTANTE=

# Opcionais. Sem Resend o e-mail espera na fila; sem Google a busca de lugar pede o link colado.
RESEND_CHAVE_API=
# Entre aspas, por causa do espaço e do <>: "Avalia Sales <nao-responda@sales.avaliaone.com.br>".
RESEND_REMETENTE=
RESEND_RESPONDER_PARA=
GOOGLE_CHAVE_DO_SERVIDOR=

# Opcional. Sem endereço, o pedido de venda espera na fila do ERP.
PROTHEUS_URL_BASE=
PROTHEUS_USUARIO=
PROTHEUS_SENHA=

# Produção (docker-compose.producao.yml)
DOMINIO=
EMAIL_DO_CERTIFICADO=
D4SIGN_URL_BASE=https://secure.d4sign.com.br/api/v1/
GOOGLE_CHAVE_DO_MAPA=
GOOGLE_ID_DO_MAPA=
SENTRY_DSN=
SENTRY_DSN_DO_FRONT=
PASTA_DE_BACKUP=/srv/avalia-sales/backups
BACKUP_DIAS=14
# Caixa que recebe a cópia diária do banco por e-mail (precisa do Resend). Vazio, só disco.
BACKUP_PARA=
