# Um domínio para todos os revendedores. ${DOMINIO} vem do ambiente (envsubst da imagem oficial).
server_tokens off;

# Texto comprimido na ida: o JS do app passa de 450 kB. Imagem e fonte já vêm
# comprimidas e ficam de fora.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml application/xml;

# Log sem a query: o hub de avisos leva o token na query (WebSocket não tem
# cabeçalho), e link de convite e de senha também. Sem o Referer, pelo mesmo motivo.
log_format sem_query '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time "$http_user_agent"';

map $http_upgrade $conexao_upgrade {
  default upgrade;
  ''      close;
}

upstream api {
  server api:8080;
  keepalive 16;
}

server {
  access_log /var/log/nginx/access.log sem_query;
  listen 80;
  server_name ${DOMINIO};

  # Desafio do Let's Encrypt (webroot do certbot).
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  access_log /var/log/nginx/access.log sem_query;
  listen 443 ssl;
  http2 on;
  server_name ${DOMINIO};

  ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;

  # Logo até 512 KB e webhook até 1 MB; acima disso nem chega à API.
  client_max_body_size 1m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # Câmera e NFC só para o próprio app, que lê a placa no balcão.
  add_header Permissions-Policy "camera=(self), nfc=(self), geolocation=(), microphone=()" always;

  # A leitura da placa (/q/) e o link curto (/l/): endereços impressos ou
  # gravados na tag, que precisam responder para sempre. Sem isto, /L/ caía no
  # app, que mandava para a entrada.
  location ~ ^/[qQlL]/ {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Nos segundos em que a API reinicia no deploy, quem lê a placa vê uma
    # espera que tenta de novo sozinha, e não um 502. A API não devolve 50x aqui.
    proxy_connect_timeout 3s;
    proxy_intercept_errors on;
    error_page 502 503 504 = @leitura_em_espera;
  }

  location @leitura_em_espera {
    default_type text/html;
    return 503 '<!doctype html><html lang="pt-BR"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="3"><title>Abrindo</title><body style="margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;color:#18181b"><p>Abrindo o link, só um instante.</p></body></html>';
  }

  location /webhooks/ {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # /api/... vai à API sem o prefixo; o hub de avisos usa WebSocket.
  location /api/ {
    proxy_pass http://api/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $conexao_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # O front: arquivo com hash no nome guarda por um ano; o resto cai no index.
  root /usr/share/nginx/html;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # A página pública /now é estática (web/public/now) e fica fora do SPA; sem
  # esta rota, o try_files de baixo mandava /now para o index do app.
  location ~ ^/now/?$ {
    add_header Cache-Control "no-cache" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), nfc=(self), geolocation=(), microphone=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.pagar.me https://maps.googleapis.com https://places.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    try_files /now/index.html =404;
  }

  location / {
    # O index nunca fica em cache: a publicação nova chega no primeiro acesso.
    add_header Cache-Control "no-cache" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), nfc=(self), geolocation=(), microphone=()" always;
    add_header X-Frame-Options "DENY" always;
    # Só o que o app chama: a API no mesmo domínio, o Pagar.me (token do cartão, direto do navegador),
    # Google Maps e Places, o Sentry e o Cloudflare Turnstile do cadastro (script, iframe e verificação em
    # challenges.cloudflare.com; a /now não usa e fica sem). Estilo em linha fica liberado: o mapa e os componentes usam.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://maps.googleapis.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.pagar.me https://maps.googleapis.com https://places.googleapis.com https://challenges.cloudflare.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    try_files $uri /index.html;
  }
}
